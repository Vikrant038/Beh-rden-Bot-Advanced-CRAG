# ─── Database ───────────────────────────────────────────────────
# App runtime user (DML only) — PoLP GUARDRAILS M1.2
DATABASE_URL=postgresql://behoerden_app:behoerden_password@localhost:5432/behoerden_bot?sslmode=require
# Migration/CI user (DDL) — NEVER used by the app runtime
MIGRATION_DATABASE_URL=postgresql://behoerden_migrator:behoerden_password@localhost:5432/behoerden_bot?sslmode=require

# ─── Auth (NextAuth v5) ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic link (Resend)
RESEND_API_KEY=
EMAIL_FROM=Behoerden Bot <onboarding@resend.dev>

# ─── LLM ────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Primary model (Groq — OpenAI-compatible, 800 tok/s)
GROQ_MODEL=llama-3.1-8b-instant
HF_TOKEN=hf_...
# Fallback model (HuggingFace Inference API)
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Cross-encoder re-ranker (HF Inference API)
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── Embeddings ─────────────────────────────────────────────────
# Base model default; swap to fine-tuned repo id later (plan Q2 decision)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# HF Inference API endpoint (feature-extraction pipeline)
HF_INFERENCE_URL=https://api-inference.huggingface.co

# ─── Cache & Rate Limiting (Upstash) ────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Observability (Langfuse) ───────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Cron guard (Vercel Cron route) ─────────────────────────────
# Same value as the Vercel CRON_SECRET env var. Vercel sends it as
# `Authorization: Bearer <secret>` on scheduled requests.
CRON_SECRET=
GEMINI_API_KEY=""

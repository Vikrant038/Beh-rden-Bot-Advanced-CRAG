# ─── Database ───────────────────────────────────────────────────
# Local dev: web-app/docker-compose.yml (pgvector:pg16, no SSL) — do NOT add
# sslmode=require to localhost URLs; local Postgres has TLS disabled.
# App runtime user (DML only) — PoLP GUARDRAILS M1.2
DATABASE_URL=postgresql://behoerden_app:behoerden_password@localhost:5432/behoerden_bot
# Migration/CI user (DDL) — NEVER used by the app runtime
MIGRATION_DATABASE_URL=postgresql://behoerden_migrator:behoerden_password@localhost:5432/behoerden_bot
#
# Cloud (Neon): use the pooled URL from the Neon console and keep sslmode=require
# DATABASE_URL=postgresql://behoerden_app:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/behoerden_bot?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://behoerden_migrator:password@ep-xxxx.eu-central-1.aws.neon.tech/behoerden_bot?sslmode=require

# ─── Auth (NextAuth v5) ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NOTE: NextAuth v5 ALSO reads AUTH_URL / AUTH_SECRET / AUTH_GITHUB_ID / etc.
# directly from process.env. Do NOT set them empty in Vercel — an empty
# AUTH_SECRET ("") overrides NEXTAUTH_SECRET and breaks OAuth callbacks with
# error=Configuration. Either leave AUTH_* unset entirely (the config pins
# secret/trustHost explicitly) or set them to the SAME valid values.

# Email magic link (Resend)
RESEND_API_KEY=
EMAIL_FROM=Behoerden Bot <onboarding@resend.dev>

# ─── LLM ────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Primary model (Groq — OpenAI-compatible, 800 tok/s)
GROQ_MODEL=llama-3.1-8b-instant
HF_TOKEN=hf_...
# Fallback model (HuggingFace Inference API)
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF Inference API base for the LLM fallback — separate from HF_INFERENCE_URL,
# which points at the Cloudflare embeddings worker (cannot serve LLMs).
HF_LLM_URL=https://api-inference.huggingface.co
# Cross-encoder re-ranker (Cloudflare worker — @cf/baai/bge-reranker-base)
RERANKER_MODEL=@cf/baai/bge-reranker-base
# Reranker endpoint — OPTIONAL. The Cloudflare worker now serves BOTH
# /pipeline/feature-extraction (bge-m3) and /pipeline/text-classification
# (bge-reranker-base) behind one token, so when unset this falls back to
# HF_INFERENCE_URL. Set it explicitly only to point at a different provider.
# (The old api-inference.huggingface.co value is treated as "unset" — it is
# unreachable from Vercel/CI and caused the silent [RERANK] fallback.)
RERANKER_URL=
# Bearer token for the Cloudflare embeddings/reranker worker (its EMBED_TOKEN
# secret). Keeps HF_TOKEN free for the HF LLM fallback.
EMBED_TOKEN=
# Reranker token — falls back to EMBED_TOKEN, then HF_TOKEN when unset.
RERANKER_TOKEN=

# ─── Embeddings ─────────────────────────────────────────────────
# Multilingual model (1024-dim) — handles the German-language corpus. Must be
# the same on the corpus side (local embed-server.py) and the query side
# (Cloudflare worker @cf/baai/bge-m3). Swap to a fine-tuned repo id later.
EMBEDDING_MODEL=BAAI/bge-m3
# Embed client used by default: "gemini" or "hf" (HF-style HTTP contract —
# works against HF Inference, the local scripts/embed-server.py, or the
# Cloudflare embeddings worker). Same model must be used on corpus AND query
# side (same-space rule).
#
# IMPORTANT: the corpus is embedded with BAAI/bge-m3 (1024-dim) via the
# Cloudflare embeddings worker (same model as the query side). Queries MUST
# use the SAME model — keep "hf" with HF_INFERENCE_URL pointing at the
# Cloudflare embeddings worker, or set "gemini" ONLY if the corpus was
# embedded with a Gemini model. A mismatch makes cosine similarity
# meaningless and silently kills dense retrieval.
EMBEDDING_PROVIDER=hf
# HF Inference API endpoint (feature-extraction pipeline). In production this
# points at the Cloudflare embeddings worker (https://<worker>.workers.dev).
# NOTE: the worker authenticates with its EMBED_TOKEN secret — HF_TOKEN in
# Vercel/local must be set to that SAME value or query embeddings get 401s.
HF_INFERENCE_URL=https://api-inference.huggingface.co

# ─── Cache & Rate Limiting (Upstash) ────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Observability (Langfuse) ───────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Cron guard (Vercel Cron route) ─────────────────────────────
# Same value as the Vercel CRON_SECRET env var. Vercel sends it as
# `Authorization: Bearer <secret>` on scheduled requests.
CRON_SECRET=
# Optional — only needed if EMBEDDING_MODEL targets a Gemini embedding model
# (default embedding path uses the HF Inference API, which needs HF_TOKEN).
GEMINI_API_KEY=
